# The complete deterministic Salt Lake City demo works without secrets.
# Live nationwide search stays disabled unless all three variables below exist.
ENABLE_LIVE_RENTCAST=false
VITE_ENABLE_LIVE_SEARCH=false
RENTCAST_API_KEY=
DATABASE_URL=

# Stay below RentCast's free 50-request monthly allocation.
RENTCAST_MONTHLY_REQUEST_CAP=45
RENTCAST_CACHE_MINUTES=30

# Reserved for the later model-enrichment adapter. No OpenAI calls ship in v0.1.
OPENAI_API_KEY=
OPENAI_PROJECT_SPEND_CAP_USD=10
